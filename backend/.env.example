# Copie para .env e preencha. O .env NUNCA vai para o Git.
FLASK_APP=wsgi.py

# postgres:// e postgresql:// também funcionam (o config.py normaliza).
DATABASE_URL=postgresql+psycopg://oriki:senha@localhost:5432/oriki
# Banco só dos testes (é apagado e recriado a cada execução do pytest).
DATABASE_URL_TESTE=postgresql+psycopg://oriki:senha@localhost:5432/oriki_test

# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Não pode mudar depois que houver dispositivos (veja `flask recifrar-chaves` para trocar).
CHAVE_CIFRA=

# 1 em produção (HTTPS), 0 local.
COOKIE_SEGURO=0
URL_PUBLICA=http://localhost:5173
FUSO=America/Belem
FRONTEND_DIST=../frontend/dist

# Quantos proxies reversos confiáveis há na frente do app (Heroku/Azure: 1). Local: 0.
PROXIES_CONFIAVEIS=0
# Opcional: arquivo do log de segurança (um por dia, guardado por LOG_SEGURANCA_DIAS).
# LOG_SEGURANCA_ARQUIVO=logs/seguranca.log
# LOG_SEGURANCA_DIAS=90
# Opcional: redis://... para usar mais de 1 worker do gunicorn.
# RATELIMIT_STORAGE_URI=memory://
